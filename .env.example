# توکن ربات تلگرام (از @BotFather بگیرید) — الزامی
BOT_TOKEN=123456:ABC-your-telegram-bot-token

# فقط برای حالت webhook (هاست وب مثل Render) — آدرس عمومی سرویس شما
# مثال: https://my-insta-bot.onrender.com
# اگر خالی باشد، ربات در حالت polling اجرا می‌شود.
WEBHOOK_URL=

# پورت (هاست‌ها معمولاً خودشان مقداردهی می‌کنند)
PORT=10000

# اختیاری: ورود به اینستاگرام برای کاهش خطای rate-limit روی سرورها
IG_USERNAME=
IG_PASSWORD=

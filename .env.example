# ---- الزامی ----
BOT_TOKEN=123456:ABC-your-telegram-bot-token

# ---- پنل مدیریت ----
# آی‌دی عددی ادمین‌ها (با کاما جدا کنید). آی‌دی خود را با دستور /id در ربات ببینید.
ADMIN_IDS=123456789

# ---- قفل عضویت اجباری (اختیاری؛ از پنل هم قابل تغییر است) ----
FORCE_JOIN=false
REQUIRED_CHANNELS=@mychannel

# ---- webhook (روی Render خودکار است) ----
WEBHOOK_URL=
PORT=10000

# ---- ذخیره‌سازی تنظیمات ----
# روی هاست با دیسک دائمی، این را به مسیر دیسک تنظیم کنید تا تنظیمات بماند.
DATA_DIR=data

# ---- اختیاری ----
# فایل کوکی برای محتوای محدودشده‌ی اینستاگرام/فیسبوک
COOKIES_FILE=
